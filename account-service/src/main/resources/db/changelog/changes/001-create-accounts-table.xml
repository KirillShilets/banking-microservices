<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.21.xsd">

    <changeSet id="001-create-accounts-table" author="Kirill Shilets">

        <createTable tableName="accounts">
            <column name="account_id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(63)">
                <constraints nullable="false"/>
            </column>

            <column name="email" type="VARCHAR(127)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="phone" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>

            <column name="creation_date" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex
                indexName="idx_account_email"
                tableName="accounts">
            <column name="email"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
