<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.21.xsd">

    <changeSet id="002-add-message-id" author="kirill">
        <addColumn tableName="deposits">
            <column name="message_id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addUniqueConstraint tableName="deposits"
                             columnNames="message_id"
                             constraintName="uk_deposits_message_id"/>
    </changeSet>
</databaseChangeLog>
